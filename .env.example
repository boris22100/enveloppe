PUBLIC_APP_URL=https://webmail.mondomaine.fr
# Générer avec : openssl rand -hex 32
SESSION_SECRET=remplace_moi_par_une_chaine_aleatoire_longue
# "*" pour autoriser tout serveur JMAP, ou liste séparée par virgules : mail.domaine1.fr,mail.domaine2.fr
ALLOWED_JMAP_SERVERS=*

# --- OIDC / OAuth2 (Optionnel) ---
# Fournisseur OIDC externe (Authentik, Keycloak...) à la place de Stalwart. Discovery : <OIDC_ISSUER>/.well-known/openid-configuration
# OIDC_ISSUER=https://auth.mondomaine.fr/application/o/enveloppe/
# Passer à "true" pour utiliser l'auto-déclaration CIMD (https://<PUBLIC_APP_URL>/oauth-client.json)
# OIDC_USE_CIMD=true
# Identifiant personnalisé si vous utilisez un client OAuth manuel (défaut : enveloppe)
# OIDC_CLIENT_ID=enveloppe
# Secret client uniquement pour un client OAuth confidentiel (laisser vide pour PKCE public)
# OIDC_CLIENT_SECRET=

# Fournisseur OIDC externe (Authentik, Keycloak, Pocket ID...) si différent du serveur JMAP :
# OIDC_ISSUER=https://auth.mondomaine.fr/application/o/enveloppe/
# OIDC_CLIENT_ID=enveloppe
# OIDC_CLIENT_SECRET=
